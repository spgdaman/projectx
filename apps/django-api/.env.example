# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# Django
SECRET_KEY=django-insecure-changeme-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app,.ngrok-free.dev

# Database — PostgreSQL (recommended)
# Create the DB first: createdb bargainhunters
# Or with Docker: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bargainhunters

# Redis (Celery broker + Django Channels layer)
REDIS_URL=redis://localhost:6379

# CORS — comma-separated origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081

# M-Pesa (Safaricom Daraja API)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok-free.app/api/v1/webhooks/mpesa/
