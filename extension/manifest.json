{
  "manifest_version": 3,
  "name": "Bargain Hunters Kenya",
  "short_name": "BHK",
  "version": "1.0.0",
  "description": "Compare grocery prices instantly across Naivas, Carrefour, Chandarana & FoodPlus.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "*://naivas.online/*",
    "*://www.naivas.online/*",
    "*://www.carrefour.ke/*",
    "*://chandarana.co.ke/*",
    "*://www.chandarana.co.ke/*",
    "*://foodplus.co.ke/*",
    "*://www.foodplus.co.ke/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Bargain Hunters Kenya"
  },
  "content_scripts": [
    {
      "matches": [
        "*://naivas.online/*",
        "*://www.naivas.online/*",
        "*://www.carrefour.ke/*",
        "*://chandarana.co.ke/*",
        "*://www.chandarana.co.ke/*",
        "*://foodplus.co.ke/*",
        "*://www.foodplus.co.ke/*"
      ],
      "js": [
        "utils/retailer_config.js",
        "utils/api_client.js",
        "content/content_script.js"
      ],
      "css": ["content/badge.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/badge.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
